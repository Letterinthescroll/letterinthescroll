rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if user is a member of a chavruta
    function isChavrutaMember(chavrutaId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/chavrutas/$(chavrutaId)).data.members;
    }

    // Check if user is the leader of a chavruta
    function isChavrutaLeader(chavrutaId) {
      return isAuth() &&
        request.auth.uid == get(/databases/$(database)/documents/chavrutas/$(chavrutaId)).data.leader;
    }

    // Check if a chavruta is a classroom
    function isClassroom(chavrutaId) {
      return get(/databases/$(database)/documents/chavrutas/$(chavrutaId)).data.isClassroom == true;
    }

    // ═══════════════════════════════════════════════════════
    // USER PROFILES
    // ═══════════════════════════════════════════════════════
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for member lists)
      allow read: if isAuth();

      // Users can only create/update their own profile
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;

      // Users cannot delete their profile
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // CHAVRUTAS (Study Groups)
    // ═══════════════════════════════════════════════════════
    match /chavrutas/{chavrutaId} {
      // Only members can read chavruta data
      allow read: if isAuth() &&
        (request.auth.uid in resource.data.members ||
         // Allow reading for join-by-code queries (checking inviteCode)
         true);

      // Note: We allow read broadly so the join-by-code query works.
      // Sensitive data (comments, reactions, etc.) is in subcollections
      // which ARE restricted to members only.

      // Any authenticated user can create a chavruta
      // Classrooms (isClassroom == true) allow up to 80 members; regular groups up to 30.
      allow create: if isAuth() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.leader == request.auth.uid &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 50 &&
        (
          (request.resource.data.isClassroom == true && request.resource.data.maxMembers <= 80) ||
          (request.resource.data.maxMembers <= 30)
        );

      // Members can update (join/leave), leader has full update
      allow update: if isAuth() &&
        (request.auth.uid in resource.data.members ||
         // Allow joining (user adding themselves via invite code)
         request.auth.uid in request.resource.data.members ||
         // Allow requesting to join (adding self to pendingMembers)
         request.auth.uid in request.resource.data.pendingMembers);

      // Only leader can delete
      allow delete: if isAuth() &&
        resource.data.leader == request.auth.uid;

      // ─── COMMENTS (scoped to chavruta) ───
      match /comments/{commentId} {
        allow read: if isChavrutaMember(chavrutaId);

        allow create: if isChavrutaMember(chavrutaId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000;

        // Comment author can delete, OR leader can delete any comment
        allow delete: if isChavrutaMember(chavrutaId) &&
          (resource.data.userId == request.auth.uid ||
           isChavrutaLeader(chavrutaId));

        allow update: if false; // Comments are immutable
      }

      // ─── REACTIONS (scoped to chavruta) ───
      match /reactions/{reactionId} {
        allow read: if isChavrutaMember(chavrutaId) ||
          (isAuth() && resource.data.userId == request.auth.uid);

        allow create: if isChavrutaMember(chavrutaId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.reactionType in ['heart', 'emphasize'];

        // Reaction author can remove, OR leader can remove (for group cleanup)
        allow delete: if isChavrutaMember(chavrutaId) &&
          (resource.data.userId == request.auth.uid ||
           isChavrutaLeader(chavrutaId));

        allow update: if false; // Reactions are immutable
      }

      // ─── BOOKMARKS (scoped to chavruta) ───
      match /bookmarks/{bookmarkId} {
        allow read: if isChavrutaMember(chavrutaId) ||
          (isAuth() && resource.data.userId == request.auth.uid);

        allow create: if isChavrutaMember(chavrutaId) &&
          request.resource.data.userId == request.auth.uid;

        // Bookmark author can remove, OR leader can remove (for group cleanup)
        allow delete: if isChavrutaMember(chavrutaId) &&
          (resource.data.userId == request.auth.uid ||
           isChavrutaLeader(chavrutaId));

        allow update: if false; // Bookmarks are immutable
      }

      // ─── PRESENCE (scoped to chavruta) ───
      match /presence/{userId} {
        allow read: if isChavrutaMember(chavrutaId);

        // Users can only write their own presence; leader can delete any (for group cleanup)
        allow create, update: if isChavrutaMember(chavrutaId) &&
          request.auth.uid == userId;
        allow delete: if isChavrutaMember(chavrutaId) &&
          (request.auth.uid == userId || isChavrutaLeader(chavrutaId));
      }

      // ─── DAILY QUOTE BOOKMARKS (scoped to chavruta) ───
      match /dailyQuoteBookmarks/{bookmarkId} {
        allow read: if isChavrutaMember(chavrutaId) ||
          (isAuth() && resource.data.userId == request.auth.uid);

        allow create: if isChavrutaMember(chavrutaId) &&
          request.resource.data.userId == request.auth.uid;

        // Bookmark author can update or remove; leader can delete (for group cleanup)
        allow update: if isChavrutaMember(chavrutaId) &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;

        allow delete: if isChavrutaMember(chavrutaId) &&
          (resource.data.userId == request.auth.uid ||
           isChavrutaLeader(chavrutaId));
      }

      // ─── CHAT MESSAGES (scoped to chavruta) ───
      match /chatMessages/{messageId} {
        allow read: if isChavrutaMember(chavrutaId);

        allow create: if isChavrutaMember(chavrutaId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000;

        // Only message author can edit their own message
        allow update: if isChavrutaMember(chavrutaId) &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000;

        // Message author can delete, OR leader can delete any message
        allow delete: if isChavrutaMember(chavrutaId) &&
          (resource.data.userId == request.auth.uid ||
           isChavrutaLeader(chavrutaId));
      }

      // ─── ANNOUNCEMENTS (classroom only) ───
      match /announcements/{announcementId} {
        allow read: if isChavrutaMember(chavrutaId);

        // Only the classroom leader can create announcements
        allow create: if isChavrutaMember(chavrutaId) &&
          isClassroom(chavrutaId) &&
          isChavrutaLeader(chavrutaId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 5000;

        // Only the leader can delete announcements
        allow delete: if isChavrutaMember(chavrutaId) &&
          isClassroom(chavrutaId) &&
          isChavrutaLeader(chavrutaId);

        allow update: if false; // Announcements are immutable
      }

      // ─── ASSIGNMENTS (classroom only) ───
      match /assignments/{assignmentId} {
        allow read: if isChavrutaMember(chavrutaId);

        // Only the classroom leader can create/update/delete assignments
        allow create: if isChavrutaMember(chavrutaId) &&
          isClassroom(chavrutaId) &&
          isChavrutaLeader(chavrutaId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.title.size() >= 1 &&
          request.resource.data.title.size() <= 200;

        allow update: if isChavrutaMember(chavrutaId) &&
          isClassroom(chavrutaId) &&
          isChavrutaLeader(chavrutaId);

        allow delete: if isChavrutaMember(chavrutaId) &&
          isClassroom(chavrutaId) &&
          isChavrutaLeader(chavrutaId);
      }

      // ─── CHAT READ RECEIPTS (scoped to chavruta) ───
      match /chatReadReceipts/{userId} {
        allow read: if isChavrutaMember(chavrutaId);

        // Users can only write their own read receipt; leader can delete any (for group cleanup)
        allow create, update: if isChavrutaMember(chavrutaId) &&
          request.auth.uid == userId;
        allow delete: if isChavrutaMember(chavrutaId) &&
          (request.auth.uid == userId || isChavrutaLeader(chavrutaId));
      }

      // ─── MITZVAH DATA (scoped to chavruta) ───
      match /mitzvah-data/{docId} {
        allow read: if isChavrutaMember(chavrutaId);

        allow create: if isChavrutaMember(chavrutaId) &&
          request.resource.data.userId == request.auth.uid;

        allow update: if isChavrutaMember(chavrutaId) &&
          resource.data.userId == request.auth.uid;

        // Author can delete, OR leader can delete (for group cleanup)
        allow delete: if isChavrutaMember(chavrutaId) &&
          (resource.data.userId == request.auth.uid ||
           isChavrutaLeader(chavrutaId));
      }
    }

    // ═══════════════════════════════════════════════════════
    // TEACHER APPLICATIONS
    // ═══════════════════════════════════════════════════════
    match /teacherApplications/{appId} {
      // Users can read their own application
      allow read: if isAuth() &&
        resource.data.userId == request.auth.uid;

      // Authenticated users can submit an application
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.institution is string &&
        request.resource.data.institution.size() >= 2 &&
        request.resource.data.institution.size() <= 200 &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() >= 2 &&
        request.resource.data.subject.size() <= 200;

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // NEWSLETTER SUBSCRIBERS
    // ═══════════════════════════════════════════════════════
    match /newsletterSubscribers/{docId} {
      // Users can only read their own subscription entry.
      allow read: if isAuth() &&
        resource.data.email == request.auth.token.email;

      // Anyone can subscribe (using email as doc ID for natural dedup)
      // Allows create and also update (so re-subscribing overwrites silently)
      allow create, update: if
        request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.source is string;

      // Users can only delete their own subscription entry
      allow delete: if isAuth() &&
        resource.data.email == request.auth.token.email;
    }

    // ═══════════════════════════════════════════════════════
    // GLOBAL REACTIONS (Psalms / Tehillim — universal)
    // Any authenticated user can read; users manage their own.
    // ═══════════════════════════════════════════════════════
    match /globalReactions/{reactionId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reactionType in ['heart', 'emphasize'];

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ═══════════════════════════════════════════════════════
    // GLOBAL BOOKMARKS (Psalms / Tehillim — universal)
    // ═══════════════════════════════════════════════════════
    match /globalBookmarks/{bookmarkId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ═══════════════════════════════════════════════════════
    // HEBREW FLASHCARDS (per-user)
    // ═══════════════════════════════════════════════════════
    match /flashcards/{cardId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════
    // SPIRITUAL JOURNAL (per-user, private)
    // ═══════════════════════════════════════════════════════
    match /journalEntries/{entryId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000
        && request.resource.data.type in ['reflection', 'mitzvah', 'gratitude', 'prayer', 'kindness'];

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    match /growthGoals/{goalId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 200;

      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════
    // DENY ALL OTHER ACCESS
    // ═══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
